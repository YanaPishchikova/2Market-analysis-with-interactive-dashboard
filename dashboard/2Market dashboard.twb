      <column caption='% of consumers with children' datatype='real' name='[Calculation_612771050722922499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Parenthood])/COUNT([Parenthood])' />
      </column>
      <column caption='% of consumers without children' datatype='real' name='[Calculation_612771050739695620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-(SUM([Parenthood])/COUNT([Parenthood]))' />
      </column>
      <column caption='% Walk-In Purchases' datatype='real' name='[Calculation_612771050794315785]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([NumWalkinPur])/(SUM([NumWalkinPur])+SUM([NumWebBuy]))' />
      </column>
      <column caption='% Web Buy' datatype='real' name='[Calculation_612771050795077643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([NumWebBuy])/(SUM([NumWalkinPur])+SUM([NumWebBuy]))' />
      </column>
      <column caption='Single' datatype='real' name='[Calculation_612771051001962516 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNT(IF[Marital Status (group)]=&apos;Single&apos;THEN [Marital Status (group)] END))/COUNT([Marital Status (group)])' />
      </column>
      <column caption='Partnered' datatype='real' name='[Calculation_612771051001962516]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(COUNT(IF[Marital Status (group)]=&apos;Partnered&apos;THEN [Marital Status (group)] END))/COUNT([Marital Status (group)])' />
      </column>
      <column caption='Total Spend' datatype='real' name='[Calculation_612771051021856794]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([AmtChocolates])+SUM([AmtLiq])+SUM([AmtComm])+SUM([AmtNonVeg])+SUM([AmtVege])+SUM([AmtPes]))/COUNT([ID])' />
      </column>
      <column caption='Filter' datatype='boolean' name='[Calculation_612771051127402524]' role='dimension' type='nominal'>
